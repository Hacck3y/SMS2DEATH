<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Neutral strip rendered behind the system status bar. Kept mid-grey on
         purpose: when com.android.phone dies the signal indicator is still
         readable through it, which is how the crash is observed on-device. -->
    <color name="strip">#FFB0B0B0</color>

    <color name="bg">#FF0A0D12</color>
    <color name="surface">#FF141A24</color>
    <color name="surface_raised">#FF1B2331</color>
    <color name="stroke">#26FFFFFF</color>
    <color name="text">#FFE9EEF7</color>
    <color name="muted">#FF8A94A6</color>
    <color name="accent">#FF3B82F6</color>
    <color name="danger">#FFE11D48</color>
    <color name="good">#FF22C55E</color>
    <color name="warn">#FFF59E0B</color>
</resources>
